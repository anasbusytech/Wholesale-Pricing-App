<div class="wholesale-pricing-widget">
  <h3 id="wholesale-widget-heading">
    Wholesale Pricing
  </h3>
  <div id="wholesale-live-price"
    style="
      font-size:24px;
      font-weight:bold;
      margin-bottom:15px;
    ">
  </div>
  <div id="wholesale-pricing-content">
    Loading...
  </div>
</div>

<script>
window.wholesaleCustomerTags =
{{ customer.tags | json }};

window.wholesaleCustomerLoggedIn =
{% if customer %}
true
{% else %}
false
{% endif %};
</script>

<script defer>
document.addEventListener("DOMContentLoaded", async () => {

  const productId =
    window.ShopifyAnalytics?.meta?.product?.id;

  let variantId =
    document.querySelector('[name="id"]')?.value;
  if (!productId) return;

  const container =
    document.getElementById(
      "wholesale-pricing-content"
    );

  const livePrice =
    document.getElementById(
      "wholesale-live-price"
    );
  const regularPrice =
    document.querySelector(
      ".price-item--regular"
    );
  const originalPriceText =
    regularPrice?.textContent;
  if (!container) return;

  const response = await fetch(
    `/apps/wholesale?productId=${productId}&variantId=${variantId}`
  );
  
  const qtyInput =
    document.querySelector(
      'input[name="quantity"]'
    );

  if (!qtyInput) return;
  
  const data = await response.json();
  const rule = data.rule;
  const widgetConfig =
    rule?.widgetConfig || {};
  const heading =
    document.getElementById(
      "wholesale-widget-heading"
    );

  const widget = document.querySelector(".wholesale-pricing-widget");

  // Find the quantity wrapper in the theme
  const qtyWrapper = 
    qtyInput.closest('.product-form__quantity') ||
    qtyInput.closest('.quantity') ||
    qtyInput.closest('.product-form__input') ||
    qtyInput.closest('.quantity-selector') ||
    qtyInput.closest('.quantity__input') ||
    qtyInput.closest('.product-form__quantity-input') ||
    qtyInput.parentElement;

  // Store the original quantity input and wrapper
  const originalQtyInput = qtyInput;
  const originalQtyWrapper = qtyWrapper;

  // Function to replace quantity switcher with dropdown
  function replaceQuantityWithDropdown(dropdownValues, initialValue) {
    // Remove any existing custom dropdown
    const existingDropdown = document.getElementById("wholesale-qty-dropdown");
    if (existingDropdown) {
      existingDropdown.remove();
    }

    // Create new dropdown
    const dropdown = document.createElement("select");
    dropdown.id = "wholesale-qty-dropdown";
    dropdown.className = "wholesale-qty-select";
    
    // Style to match theme's quantity input
    dropdown.style.width = "100%";
    dropdown.style.height = "100%";
    dropdown.style.minHeight = "45px";
    dropdown.style.padding = "10px 15px";
    dropdown.style.fontSize = "16px";
    dropdown.style.border = "1px solid #d9d9d9";
    dropdown.style.borderRadius = "4px";
    dropdown.style.backgroundColor = "#ffffff";
    dropdown.style.cursor = "pointer";

    // Add options
    dropdownValues.forEach((qty) => {
      const option = document.createElement("option");
      option.value = qty;
      option.textContent = qty;
      dropdown.appendChild(option);
    });

    // Set initial value
    dropdown.value = initialValue || dropdownValues[0];

    // Hide the original quantity input
    originalQtyInput.style.display = "none";
    
    // If we have a wrapper, clear it and add the dropdown
    if (originalQtyWrapper) {
      // Clear the wrapper but keep it
      const wrapperChildren = originalQtyWrapper.children;
      for (let i = wrapperChildren.length - 1; i >= 0; i--) {
        if (wrapperChildren[i] !== originalQtyInput) {
          wrapperChildren[i].style.display = "none";
        }
      }
      
      // If the wrapper has a specific structure, try to insert dropdown in the same position
      if (originalQtyWrapper.querySelector('.quantity__input')) {
        // For Dawn theme style
        originalQtyWrapper.querySelector('.quantity__input').style.display = 'none';
        originalQtyWrapper.appendChild(dropdown);
      } else if (originalQtyWrapper.querySelector('.product-form__quantity-input')) {
        // For other themes
        originalQtyWrapper.querySelector('.product-form__quantity-input').style.display = 'none';
        originalQtyWrapper.appendChild(dropdown);
      } else {
        // Generic fallback
        originalQtyWrapper.appendChild(dropdown);
      }
      
      // Ensure dropdown takes full width
      dropdown.style.width = originalQtyWrapper.style.width || "100%";
    } else {
      // Fallback: replace the input directly
      originalQtyInput.parentNode.insertBefore(dropdown, originalQtyInput);
    }

    // Sync dropdown with quantity input
    dropdown.addEventListener("change", () => {
      qtyInput.value = dropdown.value;
      qtyInput.dispatchEvent(new Event("input", { bubbles: true }));
      qtyInput.dispatchEvent(new Event("change", { bubbles: true }));
      // Trigger price update
      updateWholesalePrice();
    });

    // Sync quantity input changes back to dropdown
    qtyInput.addEventListener("input", () => {
      if (dropdown.value !== qtyInput.value) {
        dropdown.value = qtyInput.value;
      }
    });

    return dropdown;
  }

  // Function to restore original quantity input
  function restoreOriginalQuantityInput() {
    // Remove any custom dropdown
    const existingDropdown = document.getElementById("wholesale-qty-dropdown");
    if (existingDropdown) {
      existingDropdown.remove();
    }
    
    // Show the original quantity input
    originalQtyInput.style.display = "";
    
    // Restore any hidden children in the wrapper
    if (originalQtyWrapper) {
      const wrapperChildren = originalQtyWrapper.children;
      for (let i = wrapperChildren.length - 1; i >= 0; i--) {
        if (wrapperChildren[i] !== originalQtyInput) {
          wrapperChildren[i].style.display = "";
        }
      }
      originalQtyWrapper.style.display = "";
    }
  }

  // Check if this is a simple product (no variants) OR first load
  const isSimpleProduct = !document.querySelector('[name="id"]')?.options;

  // For simple products with no rule, hide the entire widget
  if (isSimpleProduct && !data.rule) {
    if (widget) {
      widget.style.display = "none";
    }
    return;
  }

  // For simple products with rule, show normally
  if (isSimpleProduct && data.rule) {
    if (widget) {
      widget.style.display = "";
    }
  }

  if (heading) {
    heading.textContent =
      widgetConfig.heading ||
      "Wholesale Pricing";
  }

  if (!data.rule) {
    // This is for variants with no rule - show message
    container.innerHTML =
      "<p>No wholesale pricing available for this variant.</p>";
    
    // Restore original quantity input
    restoreOriginalQuantityInput();
    qtyInput.value = "1";

    // Clear live price
    livePrice.innerHTML = "";

    // Reset regular price
    if (regularPrice && originalPriceText) {
      regularPrice.textContent = originalPriceText;
    }

    return;
  }

  // If we have a rule, show the widget
  if (widget) {
    widget.style.display = "";
  }

  let slabs = data.rule.slabs;

  let html = `
    <table style="
      width:100%;
      border-collapse:collapse;
      margin-top:10px;
    ">
      <tr>
        <th style="text-align:left; padding:8px;">Quantity</th>
        <th style="text-align:left; padding:8px;">Price</th>
      </tr>
  `;

  slabs.forEach((slab) => {
    html += `
      <tr data-min="${slab.minQty}"
          data-max="${slab.maxQty}"
          data-price="${slab.price}">
        <td style="padding:8px;">${slab.maxQty ? `${slab.minQty} - ${slab.maxQty}` : `${slab.minQty}+`}</td>
        <td style="padding:8px;">Rs.${slab.price}</td>
      </tr>
    `;
  });

  html += "</table>";
  container.innerHTML = html;

  // Handle quantity dropdown based on rule configuration
  if (
    data.rule.quantityInputEnabled &&
    data.rule.quantityDropdown?.length
  ) {
    // Replace quantity switcher with custom dropdown
    const dropdown = replaceQuantityWithDropdown(
      data.rule.quantityDropdown,
      data.rule.quantityDropdown[0]
    );
    
    qtyInput.value = data.rule.quantityDropdown[0];
    
    // Add event listener to the dropdown for price updates
    if (dropdown) {
      dropdown.addEventListener('change', updateWholesalePrice);
    }
  } else {
    // Restore original quantity input
    restoreOriginalQuantityInput();
    qtyInput.value = 1;
  }

  // Apply widget styling
  if (widget) {
    widget.style.backgroundColor =
      widgetConfig.backgroundColor ||
      "#ffffff";
    widget.style.border =
      `1px solid ${
        widgetConfig.borderColor ||
        "#d9d9d9"
      }`;
    widget.style.color =
      widgetConfig.textColor ||
      "#000000";
    widget.style.padding = "15px";
    widget.style.marginTop = "15px";
    widget.style.borderRadius = "4px";
  }

  function updateWholesalePrice() {
    console.log(
      "updateWholesalePrice fired",
      qtyInput.value
    );
    const qty =
      Number(qtyInput.value);

    let matchedSlab = null;

    for (const slab of slabs) {
      if (
        slab.maxQty === null &&
        qty >= slab.minQty
      ) {
        matchedSlab = slab;
        break;
      }

      if (
        qty >= slab.minQty &&
        qty <= slab.maxQty
      ) {
        matchedSlab = slab;
        break;
      }
    }

    document
      .querySelectorAll(
        "#wholesale-pricing-content tr"
      )
      .forEach((row) => {
        row.style.background = "transparent";
      });

    if (!matchedSlab) {
      livePrice.innerHTML = "";
      if (
        regularPrice &&
        originalPriceText
      ) {
        regularPrice.textContent =
          originalPriceText;
      }
      return;
    }

    livePrice.innerHTML =
      `Wholesale Price:
       Rs.${matchedSlab.price}`;

    document
      .querySelectorAll(
        "#wholesale-pricing-content tr"
      )
      .forEach((row) => {
        if (
          Number(row.dataset.min) ===
          matchedSlab.minQty
        ) {
          row.style.background =
            widgetConfig.highlightColor ||
            "#d1fadf";
        }
      });

    const regularPrices =
      document.querySelectorAll(
        ".price-item--regular"
      );

    regularPrices.forEach((el) => {
      el.textContent =
        `Rs.${matchedSlab.price} PKR`;
    });

    const salePrice =
      document.querySelector(
        ".price-item--sale"
      );

    if (salePrice) {
      salePrice.textContent =
        `Rs.${matchedSlab.price} PKR`;
    }
  }

  // Initial price update
  updateWholesalePrice();

  // Listen for quantity input changes
  qtyInput.addEventListener(
    "input",
    updateWholesalePrice
  );

  // Handle variant changes
  document.addEventListener("change", async (e) => {
    if (e.target.name !== "id") return;

    const newVariantId = e.target.value;

    const response = await fetch(
      `/apps/wholesale?productId=${productId}&variantId=${newVariantId}`
    );

    const data = await response.json();

    console.log("Variant Changed", data);

    if (!data.rule) {
      // Restore original quantity input
      restoreOriginalQuantityInput();
      livePrice.innerHTML = "";
      container.innerHTML =
        "<p>No wholesale pricing available for this variant.</p>";
      qtyInput.value = "1";

      // Reset regular price
      if (regularPrice && originalPriceText) {
        regularPrice.textContent = originalPriceText;
      }

      return;
    }

    slabs = data.rule.slabs;

    let html = `
      <table style="
        width:100%;
        border-collapse:collapse;
        margin-top:10px;
      ">
        <tr>
          <th style="text-align:left; padding:8px;">Quantity</th>
          <th style="text-align:left; padding:8px;">Price</th>
        </tr>
    `;

    slabs.forEach((slab) => {
      html += `
        <tr data-min="${slab.minQty}"
            data-max="${slab.maxQty}"
            data-price="${slab.price}">
          <td style="padding:8px;">
            ${slab.maxQty
              ? `${slab.minQty} - ${slab.maxQty}`
              : `${slab.minQty}+`}
          </td>
          <td style="padding:8px;">Rs.${slab.price}</td>
        </tr>
      `;
    });

    html += "</table>";
    container.innerHTML = html;

    // Remove any existing dropdown
    const existingDropdown = document.getElementById("wholesale-qty-dropdown");
    if (existingDropdown) {
      existingDropdown.remove();
    }

    if (
      data.rule.quantityInputEnabled &&
      data.rule.quantityDropdown?.length
    ) {
      // Replace with custom dropdown
      const dropdown = replaceQuantityWithDropdown(
        data.rule.quantityDropdown,
        data.rule.quantityDropdown[0]
      );
      
      qtyInput.value = data.rule.quantityDropdown[0];
      
      if (dropdown) {
        dropdown.addEventListener('change', updateWholesalePrice);
      }
    } else {
      // Restore original quantity input
      restoreOriginalQuantityInput();
      qtyInput.value = 1;
    }

    updateWholesalePrice();
  });

  const form = qtyInput?.closest("form");

  form?.addEventListener("submit", () => {
    // Ensure the quantity value is correct before submitting
    const dropdown = document.getElementById("wholesale-qty-dropdown");
    if (dropdown) {
      qtyInput.value = dropdown.value;
    }
  });
});
</script>

{% schema %}
{
  "name": "Wholesale Pricing",
  "target": "section",
  "settings": []
}
{% endschema %}