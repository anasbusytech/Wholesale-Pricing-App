<div class="wholesale-pricing-widget">
  <h3 id="wholesale-widget-heading">
    Wholesale Pricing
  </h3>
  <div id="wholesale-live-price"
    style="
      font-size:24px;
      font-weight:bold;
      margin-bottom:15px;
    ">
  </div>
  <div id="wholesale-pricing-content">
    Loading...
  </div>
</div>

<script>
window.wholesaleCustomerTags =
{{ customer.tags | json }};

window.wholesaleCustomerLoggedIn =
{% if customer %}
true
{% else %}
false
{% endif %};
</script>

<script defer>
document.addEventListener("DOMContentLoaded", async () => {

  const productId =
    window.ShopifyAnalytics?.meta?.product?.id;

  let variantId =
    document.querySelector('[name="id"]')?.value;
  if (!productId) return;

  const container =
    document.getElementById(
      "wholesale-pricing-content"
    );

  const livePrice =
    document.getElementById(
      "wholesale-live-price"
    );
  const regularPrice =
    document.querySelector(
      ".price-item--regular"
    );
  const originalPriceText =
    regularPrice?.textContent;
  if (!container) return;

  const response = await fetch(
    `/apps/wholesale?productId=${productId}&variantId=${variantId}`
  );
  const qtyInput =
    document.querySelector(
      'input[name="quantity"]'
    );

  if (!qtyInput) return;
  const data = await response.json();
  const rule = data.rule;
  const widgetConfig =
    rule?.widgetConfig || {};
  const heading =
    document.getElementById(
      "wholesale-widget-heading"
    );

  const widget = document.querySelector(".wholesale-pricing-widget");

  // Find the quantity wrapper in the theme
  const qtyWrapper = 
    qtyInput.closest('.product-form__quantity') ||
    qtyInput.closest('.quantity') ||
    qtyInput.closest('.product-form__input') ||
    qtyInput.closest('.quantity-selector') ||
    qtyInput.parentElement;

  // Store the original quantity input for later reference
  const originalQtyInput = qtyInput;

  // Check if this is a simple product (no variants) OR first load
  const isSimpleProduct = !document.querySelector('[name="id"]')?.options;

  // For simple products with no rule, hide the entire widget
  if (isSimpleProduct && !data.rule) {
    if (widget) {
      widget.style.display = "none";
    }
    return;
  }

  // For simple products with rule, show normally
  if (isSimpleProduct && data.rule) {
    if (widget) {
      widget.style.display = "";
    }
  }

  if (heading) {
    heading.textContent =
      widgetConfig.heading ||
      "Wholesale Pricing";
  }

  // Function to create and insert dropdown at the quantity input position
  function createDropdownAtQuantityPosition(dropdownValues, initialValue) {
    // Remove any existing custom dropdown
    const existingDropdown = document.getElementById("wholesale-qty-dropdown");
    if (existingDropdown) {
      existingDropdown.remove();
    }

    // Create new dropdown
    const dropdown = document.createElement("select");
    dropdown.id = "wholesale-qty-dropdown";
    dropdown.style.width = "100%";
    dropdown.style.padding = "10px";
    dropdown.style.fontSize = "16px";
    dropdown.style.border = "1px solid #d9d9d9";
    dropdown.style.borderRadius = "4px";
    dropdown.style.backgroundColor = "#ffffff";

    // Add options
    dropdownValues.forEach((qty) => {
      const option = document.createElement("option");
      option.value = qty;
      option.textContent = qty;
      dropdown.appendChild(option);
    });

    // Set initial value
    dropdown.value = initialValue || dropdownValues[0];

    // Hide the original quantity input
    if (qtyWrapper) {
      // Store the original input's display style
      originalQtyInput.style.display = "none";
      
      // Insert dropdown right next to the hidden input
      // This ensures it appears exactly where the quantity input was
      originalQtyInput.parentNode.insertBefore(dropdown, originalQtyInput.nextSibling);
      
      // Style the dropdown to match the original input's container
      dropdown.style.width = qtyWrapper.style.width || "100%";
    } else {
      // Fallback: insert after the quantity input
      originalQtyInput.parentNode.insertBefore(dropdown, originalQtyInput.nextSibling);
    }

    // Sync dropdown with quantity input
    dropdown.addEventListener("change", () => {
      qtyInput.value = dropdown.value;
      qtyInput.dispatchEvent(new Event("input", { bubbles: true }));
      // Also trigger any theme-specific events
      qtyInput.dispatchEvent(new Event("change", { bubbles: true }));
    });

    // Sync quantity input changes back to dropdown (if someone uses the input)
    qtyInput.addEventListener("input", () => {
      if (dropdown.value !== qtyInput.value) {
        dropdown.value = qtyInput.value;
      }
    });

    return dropdown;
  }

  // Function to show the original quantity input (for no-rule or dropdown disabled)
  function showOriginalQuantityInput() {
    // Remove any custom dropdown
    const existingDropdown = document.getElementById("wholesale-qty-dropdown");
    if (existingDropdown) {
      existingDropdown.remove();
    }
    
    // Show the original quantity input
    originalQtyInput.style.display = "";
    if (qtyWrapper) {
      qtyWrapper.style.display = "";
    }
  }

  if (!data.rule) {
    // This is for variants with no rule - show message with dropdown
    container.innerHTML =
      "<p>No wholesale pricing available for this variant.</p>";
    
    // Create default dropdown at the quantity input position
    const quantities = [
      1,2,3,4,5,
      10,15,20,25,30,
      40,50,75,100
    ];

    createDropdownAtQuantityPosition(quantities, "1");
    qtyInput.value = "1";

    // Show the quantity input for variants without rule
    showOriginalQuantityInput();

    // Clear live price
    livePrice.innerHTML = "";

    // Reset regular price
    if (regularPrice && originalPriceText) {
      regularPrice.textContent = originalPriceText;
    }

    return;
  }

  // If we have a rule, show the widget
  if (widget) {
    widget.style.display = "";
  }

  let slabs = data.rule.slabs;

  let html = `
    <table style="
      width:100%;
      border-collapse:collapse;
    ">
      <tr>
        <th>Quantity</th>
        <th>Price</th>
      </tr>
  `;

  slabs.forEach((slab) => {
    html += `
      <tr data-min="${slab.minQty}"
          data-max="${slab.maxQty}"
          data-price="${slab.price}">
        <td>${slab.maxQty ? `${slab.minQty} - ${slab.maxQty}` : `${slab.minQty}+`}</td>
        <td>Rs.${slab.price}</td>
      </tr>
    `;
  });

  html += "</table>";
  container.innerHTML = html;

  // Handle quantity dropdown based on rule configuration
  if (
    data.rule.quantityInputEnabled &&
    data.rule.quantityDropdown?.length
  ) {
    // Create custom dropdown at the quantity input position
    createDropdownAtQuantityPosition(
      data.rule.quantityDropdown,
      data.rule.quantityDropdown[0]
    );
    
    qtyInput.value = data.rule.quantityDropdown[0];
  } else {
    // Show the original quantity input
    showOriginalQuantityInput();
    qtyInput.value = 1;
  }

  // Apply widget styling
  if (widget) {
    widget.style.backgroundColor =
      widgetConfig.backgroundColor ||
      "#ffffff";
    widget.style.border =
      `1px solid ${
        widgetConfig.borderColor ||
        "#d9d9d9"
      }`;
    widget.style.color =
      widgetConfig.textColor ||
      "#000000";
    widget.style.padding = "15px";
  }

  function updateWholesalePrice() {
    console.log(
      "updateWholesalePrice fired",
      qtyInput.value
    );
    const qty =
      Number(qtyInput.value);

    let matchedSlab = null;

    for (const slab of slabs) {
      if (
        slab.maxQty === null &&
        qty >= slab.minQty
      ) {
        matchedSlab = slab;
        break;
      }

      if (
        qty >= slab.minQty &&
        qty <= slab.maxQty
      ) {
        matchedSlab = slab;
        break;
      }
    }

    document
      .querySelectorAll(
        "#wholesale-pricing-content tr"
      )
      .forEach((row) => {
        row.style.background = "transparent";
      });

    if (!matchedSlab) {
      livePrice.innerHTML = "";
      if (
        regularPrice &&
        originalPriceText
      ) {
        regularPrice.textContent =
          originalPriceText;
      }
      return;
    }

    livePrice.innerHTML =
      `Wholesale Price:
       Rs.${matchedSlab.price}`;

    document
      .querySelectorAll(
        "#wholesale-pricing-content tr"
      )
      .forEach((row) => {
        if (
          Number(row.dataset.min) ===
          matchedSlab.minQty
        ) {
          row.style.background =
            widgetConfig.highlightColor ||
            "#d1fadf";
        }
      });

    const regularPrices =
      document.querySelectorAll(
        ".price-item--regular"
      );

    regularPrices.forEach((el) => {
      el.textContent =
        `Rs.${matchedSlab.price} PKR`;
    });

    const salePrice =
      document.querySelector(
        ".price-item--sale"
      );

    if (salePrice) {
      salePrice.textContent =
        `Rs.${matchedSlab.price} PKR`;
    }
  }

  // Listen for quantity input changes
  qtyInput.addEventListener(
    "input",
    updateWholesalePrice
  );

  // Also listen for changes on the custom dropdown
  const dropdown = document.getElementById("wholesale-qty-dropdown");
  if (dropdown) {
    dropdown.addEventListener("change", () => {
      updateWholesalePrice();
    });
  }

  // Initial price update
  updateWholesalePrice();

  // Handle variant changes
  document.addEventListener("change", async (e) => {
    if (e.target.name !== "id") return;

    const newVariantId = e.target.value;

    const response = await fetch(
      `/apps/wholesale?productId=${productId}&variantId=${newVariantId}`
    );

    const data = await response.json();

    console.log("Variant Changed", data);

    if (!data.rule) {
      // Remove any custom dropdown
      const existingDropdown = document.getElementById("wholesale-qty-dropdown");
      if (existingDropdown) {
        existingDropdown.remove();
      }

      livePrice.innerHTML = "";

      container.innerHTML =
        "<p>No wholesale pricing available for this variant.</p>";

      // Create default dropdown at quantity position
      const quantities = [
        1,2,3,4,5,
        10,15,20,25,30,
        40,50,75,100
      ];

      createDropdownAtQuantityPosition(quantities, "1");
      qtyInput.value = "1";

      // Show the original quantity input
      showOriginalQuantityInput();

      // Reset regular price
      if (regularPrice && originalPriceText) {
        regularPrice.textContent = originalPriceText;
      }

      return;
    }

    slabs = data.rule.slabs;

    let html = `
      <table style="
        width:100%;
        border-collapse:collapse;
      ">
        <tr>
          <th>Quantity</th>
          <th>Price</th>
        </tr>
    `;

    slabs.forEach((slab) => {
      html += `
        <tr data-min="${slab.minQty}"
            data-max="${slab.maxQty}"
            data-price="${slab.price}">
          <td>
            ${slab.maxQty
              ? `${slab.minQty} - ${slab.maxQty}`
              : `${slab.minQty}+`}
          </td>
          <td>Rs.${slab.price}</td>
        </tr>
      `;
    });

    html += "</table>";
    container.innerHTML = html;

    // Remove any existing dropdown
    const existingDropdown = document.getElementById("wholesale-qty-dropdown");
    if (existingDropdown) {
      existingDropdown.remove();
    }

    if (
      data.rule.quantityInputEnabled &&
      data.rule.quantityDropdown?.length
    ) {
      // Create custom dropdown at quantity position
      createDropdownAtQuantityPosition(
        data.rule.quantityDropdown,
        data.rule.quantityDropdown[0]
      );
      
      qtyInput.value = data.rule.quantityDropdown[0];
    } else {
      // Show original quantity input
      showOriginalQuantityInput();
      qtyInput.value = 1;
    }

    console.log(
      "Running price refresh"
    );
    updateWholesalePrice();
  });

  function getQtyInput() {
    return document.querySelector('input[name="quantity"]');
  }

  const form = qtyInput?.closest("form");

  form?.addEventListener("submit", () => {
    qtyInput.value = qtyInput.value;
  });
});
</script>

{% schema %}
{
  "name": "Wholesale Pricing",
  "target": "section",
  "settings": []
}
{% endschema %}